<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Reusable single-arm NERO macro.
    prefix:    left_ / right_
    parent:    the link this arm is fixed to
    xyz/rpy:   arm mount pose relative to parent
  -->
  <xacro:macro name="nero_single_arm" params="prefix parent xyz:='0 0 0' rpy:='0 0 0' use_sim_visuals:='false'">
    <xacro:property name="base_visual_mesh" value="${'package://dual_nero_description/meshes/base_link.STL' if use_sim_visuals == 'true' else 'package://dual_nero_description/meshes/dae/base_link.dae'}"/>
    <xacro:property name="link1_visual_mesh" value="${'package://dual_nero_description/meshes/Link1.STL' if use_sim_visuals == 'true' else 'package://dual_nero_description/meshes/dae/link1.dae'}"/>
    <xacro:property name="link2_visual_mesh" value="${'package://dual_nero_description/meshes/Link2.STL' if use_sim_visuals == 'true' else 'package://dual_nero_description/meshes/dae/link2.dae'}"/>
    <xacro:property name="link3_visual_mesh" value="${'package://dual_nero_description/meshes/Link3.STL' if use_sim_visuals == 'true' else 'package://dual_nero_description/meshes/dae/link3.dae'}"/>
    <xacro:property name="link4_visual_mesh" value="${'package://dual_nero_description/meshes/Link4.STL' if use_sim_visuals == 'true' else 'package://dual_nero_description/meshes/dae/link4.dae'}"/>
    <xacro:property name="link5_visual_mesh" value="${'package://dual_nero_description/meshes/Link5.STL' if use_sim_visuals == 'true' else 'package://dual_nero_description/meshes/dae/link5.dae'}"/>
    <xacro:property name="link6_visual_mesh" value="${'package://dual_nero_description/meshes/Link6.STL' if use_sim_visuals == 'true' else 'package://dual_nero_description/meshes/dae/link6.dae'}"/>
    <xacro:property name="link7_visual_mesh" value="${'package://dual_nero_description/meshes/Link7.STL' if use_sim_visuals == 'true' else 'package://dual_nero_description/meshes/dae/link7.dae'}"/>
    <xacro:property name="ee_visual_mesh" value="${'package://dual_nero_description/meshes/stand_v2.STL' if use_sim_visuals == 'true' else 'package://dual_nero_description/meshes/stand_v1.dae'}"/>
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="-0.00963614954335565 0.00016786624100977 0.044860101664403" rpy="0 0 0"/>
        <mass value="0.77"/>
        <inertia ixx="0.0006669" ixy="0.0" ixz="0.0" iyy="0.00054501" iyz="0.0" izz="0.00051509"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${base_visual_mesh}"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://dual_nero_description/meshes/base_link.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="${prefix}link1">
      <inertial>
        <origin xyz="-0.00077 -0.00006 -0.00686" rpy="0 0 0"/>
        <mass value="0.77"/>
        <inertia ixx="0.0006669" ixy="0.0" ixz="0.0" iyy="0.00054501" iyz="0.0" izz="0.00051509"/>
      </inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="${link1_visual_mesh}"/></geometry></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://dual_nero_description/meshes/Link1.STL"/></geometry></collision>
    </link>
    <joint name="${prefix}joint1" type="revolute">
      <origin xyz="0 0 0.138" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link1"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.7" upper="2.7" effort="50" velocity="1.0"/>
    </joint>

    <link name="${prefix}link2">
      <inertial>
        <origin xyz="-0.00011 -0.06072 0.00148" rpy="0 0 0"/>
        <mass value="0.49"/>
        <inertia ixx="0.00053808" ixy="0.0" ixz="0.0" iyy="0.00029435" iyz="0.0" izz="0.00040266"/>
      </inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="${link2_visual_mesh}"/></geometry></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://dual_nero_description/meshes/Link2.STL"/></geometry></collision>
    </link>
    <joint name="${prefix}joint2" type="revolute">
      <origin xyz="0 0 0" rpy="1.5708 3.1415 0"/>
      <parent link="${prefix}link1"/>
      <child link="${prefix}link2"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.74" upper="1.74" effort="50" velocity="1.0"/>
    </joint>

    <link name="${prefix}link3">
      <inertial>
        <origin xyz="0.00014 0.00211 -0.04853" rpy="0 0 0"/>
        <mass value="0.67"/>
        <inertia ixx="0.00342528" ixy="0.0" ixz="0.0" iyy="0.0033924" iyz="0.0" izz="0.00026169"/>
      </inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="${link3_visual_mesh}"/></geometry></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://dual_nero_description/meshes/Link3.STL"/></geometry></collision>
    </link>
    <joint name="${prefix}joint3" type="revolute">
      <origin xyz="0 -0.31 0" rpy="-1.5708 0 3.1416"/>
      <parent link="${prefix}link2"/>
      <child link="${prefix}link3"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.75" upper="2.75" effort="50" velocity="1.0"/>
    </joint>

    <link name="${prefix}link4">
      <inertial>
        <origin xyz="-0.00013 -0.05482 0.00132" rpy="0 0 0"/>
        <mass value="0.41"/>
        <inertia ixx="0.00031331" ixy="0.0" ixz="0.0" iyy="0.00013204" iyz="0.0" izz="0.0002393"/>
      </inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="${link4_visual_mesh}"/></geometry></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://dual_nero_description/meshes/Link4.STL"/></geometry></collision>
    </link>
    <joint name="${prefix}joint4" type="revolute">
      <origin xyz="0 0 0" rpy="-1.5708 0 3.1416"/>
      <parent link="${prefix}link3"/>
      <child link="${prefix}link4"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.01" upper="2.14" effort="50" velocity="1.0"/>
    </joint>

    <link name="${prefix}link5">
      <inertial>
        <origin xyz="0.00303 0.00617 -0.11778" rpy="0 0 0"/>
        <mass value="0.56"/>
        <inertia ixx="0.0008249" ixy="0.0" ixz="0.0" iyy="0.00078548" iyz="0.0" izz="0.00021015"/>
      </inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="${link5_visual_mesh}"/></geometry></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://dual_nero_description/meshes/Link5.STL"/></geometry></collision>
    </link>
    <joint name="${prefix}joint5" type="revolute">
      <origin xyz="0 -0.27001 0" rpy="1.5708 -1.5708 0"/>
      <parent link="${prefix}link4"/>
      <child link="${prefix}link5"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.75" upper="2.75" effort="50" velocity="1.0"/>
    </joint>

    <link name="${prefix}link6">
      <inertial>
        <origin xyz="0.00014 -0.0027 -0.00025" rpy="0 0 0"/>
        <mass value="0.31"/>
        <inertia ixx="0.00008181" ixy="0.0" ixz="0.0" iyy="0.00007176" iyz="0.0" izz="0.00007906"/>
      </inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="${link6_visual_mesh}"/></geometry></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://dual_nero_description/meshes/Link6.STL"/></geometry></collision>
    </link>
    <joint name="${prefix}joint6" type="revolute">
      <origin xyz="0 0 0" rpy="1.5708 -1.5708 0"/>
      <parent link="${prefix}link5"/>
      <child link="${prefix}link6"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.73" upper="0.95" effort="50" velocity="1.0"/>
    </joint>

    <link name="${prefix}link7">
      <inertial>
        <origin xyz="-0.00014000 -0.00010000 -0.00275000" rpy="0 0 0"/>
        <mass value="0.000001"/>
        <inertia ixx="1.1000000000000001e-07" ixy="0" ixz="0" iyy="1.1000000000000001e-07" iyz="0" izz="1.9999999999999999e-07"/>
      </inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="${link7_visual_mesh}"/></geometry></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://dual_nero_description/meshes/Link7.STL"/></geometry></collision>
    </link>
    <joint name="${prefix}joint7" type="revolute">
      <origin xyz="0 -0.0235 0" rpy="1.5708 0 0"/>
      <parent link="${prefix}link6"/>
      <child link="${prefix}link7"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57" upper="1.57" effort="50" velocity="1.0"/>
    </joint>

    <link name="${prefix}end_effector">
      <inertial>
        <origin xyz="-0.01208 -0.00025 0.00032" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="2.697e-05" ixy="0" ixz="0" iyy="4.311e-05" iyz="0" izz="2.479e-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="-1.57 -1.57 -1.57"/>
        <geometry><mesh filename="${ee_visual_mesh}"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="-1.57 -1.57 -1.57"/>
        <geometry><mesh filename="${'package://dual_nero_description/meshes/stand_v2.STL' if use_sim_visuals == 'true' else 'package://dual_nero_description/meshes/stand_v1.dae'}"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}end_effector_joint" type="fixed">
      <origin xyz="0.033 0.00000000 -0.02350000" rpy="0 0 0"/>
      <parent link="${prefix}link7"/>
      <child link="${prefix}end_effector"/>
    </joint>
  </xacro:macro>
</robot>
