<?xml version="1.0"?>
<package format="3">
  <name>dual_nero_bridge</name>
  <version>0.1.0</version>
  <description>Real hardware execution bridge for the dual-arm NERO robot on ROS 2 Humble.</description>
  <maintainer email="15138756873@163.com">yang-hrs</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>dual_nero_driver</exec_depend>
  <exec_depend>dual_nero_moveit_config</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
